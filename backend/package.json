{
  "name": "remedy-notifier-bot",
  "version": "2025.10.10",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "inspectDev": "nodemon --watch \"src/**/*\" -e ts,json --exec \"node --inspect -r ts-node/register -r tsconfig-paths/register src/index.ts\"",
    "dev": "nodemon -r tsconfig-paths/register ./src/index.ts",
    "prepare-dataset": "npx ts-node src/datasets/humanDataset/mergeJsons.ts && npx ts-node src/datasets/humanDataset/filterByTokens.ts",
    "merge-ai-dataset": "npx ts-node src/datasets/aiDataset/scripts/mergeDatasets.ts",
    "generate-openai5.2": "npx ts-node src/datasets/aiDataset/scripts/runOpenAI5.2.ts",
    "generate-openai4.1": "npx ts-node src/datasets/aiDataset/scripts/runOpenAI4.1.ts",
    "generate-mimo": "npx ts-node src/datasets/aiDataset/scripts/runMiMo.ts",
    "generate-deepseek": "npx ts-node src/datasets/aiDataset/scripts/runDeepseekChimera.ts",
    "generate-gemini": "npx ts-node src/datasets/aiDataset/scripts/runGeminiFlashLite.ts",
    "generate-haiku": "npx ts-node src/datasets/aiDataset/scripts/runClaudeHaiku.ts",
    "generate-sonnet45": "npx ts-node src/datasets/aiDataset/scripts/runClaudeSonnet45.ts",
    "generate-sonnet4": "npx ts-node src/datasets/aiDataset/scripts/runClaudeSonnet4.ts",
    "generate-grok41": "npx ts-node src/datasets/aiDataset/scripts/runGrok41.ts",
    "generate-grok-code": "npx ts-node src/datasets/aiDataset/scripts/runGrokCode.ts",
    "generate-gemini3": "npx ts-node src/datasets/aiDataset/scripts/runGemini3Flash.ts",
    "generate-deepseek32": "npx ts-node src/datasets/aiDataset/scripts/runDeepseekV32.ts",
    "generate-gpt-oss": "npx ts-node src/datasets/aiDataset/scripts/runGptOss120b.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "body-parser": "^2.2.0",
    "cls-hooked": "^4.2.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "emoji-regex": "^10.6.0",
    "express": "^5.1.0",
    "nodemon": "^3.1.10",
    "openai": "^5.23.2",
    "pg": "^8.16.3",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cls-hooked": "^4.3.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.1",
    "@types/pg": "^8.15.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
